{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"baseUrl": "./",
		"esModuleInterop": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"module": "ESNext",
		"moduleResolution": "node",
		"noEmit": true,
		"outDir": "Target",
		"rootDir": "src",
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext"
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"src/**.ts",
		"src/**.tsx",
		"src"
	]
}
